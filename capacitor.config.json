{
  "appId": "com.mattshaffer.toweringwaters",
  "appName": "Towering Waters: Gateway's Descent",
  "webDir": ".",
  "bundledWebRuntime": false,
  "backgroundColor": "#041421",
  "loggingBehavior": "production",
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": []
  },
  "android": {
    "backgroundColor": "#041421",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "useLegacyBridge": false,
    "initialFocus": true,
    "buildOptions": {
      "releaseType": "AAB"
    },
    "minWebViewVersion": 108
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#041421",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#00000000"
    }
  }
}

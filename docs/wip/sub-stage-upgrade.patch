+
+  // Compile every shader program up front (hidden / not-yet-spawned things included) so the first
+  // sparkle, the next tower or the arrival shot never hitch mid-ride. With
+  // KHR_parallel_shader_compile this happens in the background right away; without it, it is done
+  // synchronously just before the first frame of the ride (where most programs compiled anyway).
+  _precompile() {
+    const gl = this.gl;
+    this._needsCompile = false;
+    if (!gl || typeof gl.compile !== 'function') return;
+    let parallel = false;
+    try {
+      parallel = !!(gl.extensions && gl.extensions.has && gl.extensions.has('KHR_parallel_shader_compile'));
+    } catch (_) {
+      parallel = false;
+    }
+    if (parallel && typeof gl.compileAsync === 'function') {
+      try {
+        gl.compileAsync(this.scene, this.camera).catch(() => {});
+        gl.compileAsync(this.overlay, this.oCam).catch(() => {});
+      } catch (_) {
+        this._needsCompile = true;
+      }
+    } else this._needsCompile = true;
   }
 
